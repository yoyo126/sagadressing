# ============================================================
#  Saga Dressing — règles du serveur web
# ============================================================

# --- HTTPS obligatoire ---------------------------------------
# Une connexion en clair exposerait le mot de passe et le cookie
# de session à qui écoute le réseau.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# --- Fichiers qui ne doivent jamais être servis ---------------
# config.php contient l'accès à la base ; les .sql, la structure.
<FilesMatch "^(config\.php|config\.example\.php|.*\.sql|.*\.md)$">
  Require all denied
</FilesMatch>

# Fichiers cachés (.git, .env, .htaccess…)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Les DOSSIERS cachés aussi : la règle ci-dessus ne vise que le nom du
# fichier, si bien que /.ssh/authorized_keys passait au travers.
<IfModule mod_rewrite.c>
  RewriteRule (^|/)\. - [F,L]
</IfModule>

# --- En-têtes de sécurité -------------------------------------
<IfModule mod_headers.c>
  # Le navigateur n'accepte plus que le HTTPS pour ce domaine, pendant un an
  Header always set Strict-Transport-Security "max-age=31536000"
  # Pas d'interprétation « maligne » du type de contenu
  Header always set X-Content-Type-Options "nosniff"
  # Le CRM ne doit pas être affichable dans le cadre d'un autre site
  Header always set X-Frame-Options "SAMEORIGIN"
  # L'adresse des pages n'est pas transmise aux sites tiers
  Header always set Referrer-Policy "same-origin"
  # Ni caméra, ni micro, ni position : l'application n'en a aucun usage
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- Pas d'index de répertoire --------------------------------
Options -Indexes

# --- Page d'accueil -------------------------------------------
DirectoryIndex index.php index.html
